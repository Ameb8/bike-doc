# Bike Doc local development environment.
# Copy this file to .env at the repository root before running Docker Compose.

# FastAPI application title.
BIKE_DOC_API_APP_NAME="Bike Doc API"

# Runtime environment name, such as local, test, or production.
BIKE_DOC_API_ENVIRONMENT=local

# FastAPI debug mode.
BIKE_DOC_API_DEBUG=true

# JSON list of local/development browser origins allowed by CORS.
BIKE_DOC_API_CORS_ORIGINS='["http://localhost:3000","http://localhost:8080"]'

# SQLAlchemy async database URL used by the API and Alembic.
BIKE_DOC_API_DATABASE_URL=postgresql+asyncpg://bikedoc:bikedoc@db:5432/bikedoc

# Auth mode: firebase in production, dev or local_unsigned_jwt for local/test only.
BIKE_DOC_API_AUTH_MODE=dev
BIKE_DOC_API_DEV_AUTH_TOKEN=dev-token
BIKE_DOC_API_DEV_AUTH_SUBJECT=dev-user
BIKE_DOC_API_DEV_AUTH_EMAIL=dev@example.com
BIKE_DOC_API_DEV_AUTH_DISPLAY_NAME="Dev User"
BIKE_DOC_API_FIREBASE_PROJECT_ID=

# Optional stdlib logging level override, such as DEBUG, INFO, WARNING, or ERROR.
BIKE_DOC_API_LOG_LEVEL=DEBUG

# Optional logging renderer override: console or json.
BIKE_DOC_API_LOG_FORMAT=

# Artifact uploads use local storage by default.
# For production, set provider=gcs, set the bucket name below, and run the API
# with an attached Google service account that has access to that bucket.
# Prefer runtime-native identity such as Cloud Run, GKE Workload Identity, or a
# VM service account over long-lived JSON keys.
BIKE_DOC_API_ARTIFACT_STORAGE_PROVIDER=local
BIKE_DOC_API_ARTIFACT_LOCAL_STORAGE_ROOT=apps/api/.local/artifacts
BIKE_DOC_API_ARTIFACT_GCS_BUCKET=
BIKE_DOC_API_ARTIFACT_MAX_UPLOAD_BYTES=10485760

# Local-only fallback for Google Application Default Credentials when not
# running with an attached service account. Production should not rely on a
# manually distributed JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional explicit Google Cloud project for ADC resolution. Many production
# runtimes provide this automatically through the attached identity.
GOOGLE_CLOUD_PROJECT=

# Diagnostic LLM runtime provider: google_ai or vertex_ai.
BIKE_DOC_API_DIAGNOSTIC_LLM_PROVIDER=google_ai

# Gemini model and generation settings used by the internal diagnostic ADK agent.
BIKE_DOC_API_DIAGNOSTIC_AGENT_MODEL=gemini-2.5-flash
BIKE_DOC_API_DIAGNOSTIC_AGENT_TEMPERATURE=0.2
BIKE_DOC_API_DIAGNOSTIC_AGENT_MAX_OUTPUT_TOKENS=2048
BIKE_DOC_API_DIAGNOSTIC_AGENT_TIMEOUT_SECONDS=30

# Isolated shadow profile-inference runtime. This is not part of the diagnostic
# ADK graph and uses the same Google credentials configured below.
BIKE_DOC_API_PROFILE_INFERENCE_LLM_PROVIDER=google_ai
BIKE_DOC_API_PROFILE_INFERENCE_MODEL=gemini-2.5-flash
BIKE_DOC_API_PROFILE_INFERENCE_TIMEOUT_SECONDS=30
BIKE_DOC_API_PROFILE_INFERENCE_EXTRACTOR_VERSION=rear-brake-shadow.v1
# Resolver policy: production only uses evaluation-promoted policies; bootstrap-v1
# is a non-production development mode for the rear-brake tracer.
BIKE_DOC_API_PROFILE_INFERENCE_RESOLVER_POLICY=production

# Price lookup provider: unavailable or gemini_grounded.
BIKE_DOC_API_PRICE_LOOKUP_PROVIDER=unavailable

# Live price lookup LLM provider: google_ai or vertex_ai.
BIKE_DOC_API_PRICE_LOOKUP_LLM_PROVIDER=google_ai

# Gemini model and generation settings used by grounded listing lookup.
BIKE_DOC_API_PRICE_LOOKUP_MODEL=gemini-2.5-flash
BIKE_DOC_API_PRICE_LOOKUP_TEMPERATURE=0.1
BIKE_DOC_API_PRICE_LOOKUP_MAX_OUTPUT_TOKENS=1536
BIKE_DOC_API_PRICE_LOOKUP_TIMEOUT_SECONDS=20

# Google AI provider credentials. Set one when DIAGNOSTIC_LLM_PROVIDER=google_ai.
# Also used when PROFILE_INFERENCE_LLM_PROVIDER=google_ai.
# Also used when PRICE_LOOKUP_PROVIDER=gemini_grounded and
# PRICE_LOOKUP_LLM_PROVIDER=google_ai.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Vertex AI provider environment. Required when DIAGNOSTIC_LLM_PROVIDER=vertex_ai.
# Also required when PROFILE_INFERENCE_LLM_PROVIDER=vertex_ai.
# Also required when PRICE_LOOKUP_PROVIDER=gemini_grounded and
# PRICE_LOOKUP_LLM_PROVIDER=vertex_ai.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Local Docker Compose host port for the API service.
BIKE_DOC_API_PORT=8000

# Local Docker Compose Postgres container settings.
POSTGRES_USER=bikedoc
POSTGRES_PASSWORD=bikedoc
POSTGRES_DB=bikedoc
POSTGRES_PORT=5432
